// Paste this file into https://dbdiagram.io/d
// Source: apps/backend/prisma/schema.prisma
Project AI_Robot_Butler {
  database_type: 'PostgreSQL'
  Note: 'Database ER diagram. Live robot POIs are stored on the robot via its REST API, separately from the pois table.'
}

Enum user_role {
  viewer
  operator
  admin
}
Enum map_status {
  draft
  published
  archived
}
Enum job_source {
  operator
  kiosk_touch
  kiosk_voice
  auto
}
Enum job_status {
  queued
  navigating
  arrived
  cancelled
  failed
  stopped
}

Table users {
  id bigint [pk, increment]
  username text [not null, unique]
  display_name text [not null]
  email text [unique]
  password_hash text [not null]
  role user_role [not null, default: 'viewer']
  is_active boolean [not null, default: true]
  last_login_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table sessions {
  sid text [pk]
  sess jsonb [not null]
  expire timestamp [not null]
}

Table robots {
  id bigint [pk, increment]
  code text [not null, unique]
  model text [not null, default: 'SLAMTEC Hermes Pro Max']
  base_url text [not null]
  is_enabled boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
}

Table maps {
  id bigint [pk, increment]
  robot_id bigint [not null]
  version integer [not null]
  status map_status [not null, default: 'draft']
  name text [not null]
  width_m decimal(6,2) [not null]
  height_m decimal(6,2) [not null]
  geometry jsonb [not null]
  slam_map_ref text
  created_by bigint [note: 'User ID; no foreign key declared in Prisma']
  published_by bigint [note: 'User ID; no foreign key declared in Prisma']
  published_at timestamp
  created_at timestamp [not null, default: `now()`]
  indexes {
    (robot_id, version) [unique]
    (robot_id, status)
  }
}

Table pois {
  id bigint [pk, increment]
  map_id bigint [not null]
  code text [not null]
  name_th text [not null]
  name_en text [not null]
  x decimal(8,3) [not null]
  y decimal(8,3) [not null]
  heading_deg decimal(5,1)
  zone text
  is_public boolean [not null, default: true]
  is_dock boolean [not null, default: false]
  sort_order integer [not null, default: 0]
  indexes {
    (map_id, code) [unique]
  }
  Note: 'Website database POIs. Separate from POIs stored directly on the robot.'
}

Table keepout_zones {
  id bigint [pk, increment]
  map_id bigint [not null]
  name text [not null]
  polygon jsonb [not null]
}

Table jobs {
  id bigint [pk, increment]
  ref text [not null, unique]
  robot_id bigint [not null]
  map_version integer [not null]
  dest_poi_code text [not null, note: 'Destination code; no foreign key declared']
  dest_name text [not null]
  source job_source [not null]
  requested_by bigint [note: 'User ID; no foreign key declared in Prisma']
  status job_status [not null, default: 'queued']
  distance_m decimal(8,2)
  departed_at timestamp
  arrived_at timestamp
  cancel_reason text
  created_at timestamp [not null, default: `now()`]
  indexes {
    (robot_id, created_at) [note: 'Prisma orders created_at DESC']
  }
}

Table job_events {
  id bigint [pk, increment]
  job_id bigint [not null]
  at timestamp [not null, default: `now()`]
  kind text [not null]
  detail jsonb
}

Table telemetry_samples {
  robot_id bigint [not null]
  at timestamp [not null]
  battery_pct decimal(5,2)
  x decimal(8,3)
  y decimal(8,3)
  heading_deg decimal(5,1)
  speed_mps decimal(5,2)
  wifi_dbm integer
  cpu_pct integer
  indexes {
    (robot_id, at) [pk]
  }
}

Table control_lock {
  robot_id bigint [pk]
  held_by bigint [note: 'User ID; no foreign key declared in Prisma']
  mode text [not null]
  acquired_at timestamp [not null, default: `now()`]
  expires_at timestamp
}

Table audit_log {
  id bigint [pk, increment]
  at timestamp [not null, default: `now()`]
  user_id bigint [note: 'User ID; no foreign key declared in Prisma']
  action text [not null]
  target text
  detail jsonb
  ip text
}

Table ai_conversations {
  id bigint [pk, increment]
  at timestamp [not null, default: `now()`]
  lang text [not null]
  transcript text [not null]
  intent text
  confidence decimal(4,3)
  job_id bigint [note: 'Job ID; no foreign key declared in Prisma']
  latency_ms integer
}

Table ai_rejections {
  id bigint [pk, increment]
  at timestamp [not null, default: `now()`]
  transcript text [not null]
  reason text [not null]
  detail jsonb
}

// Physical foreign keys only; user IDs and destination codes above are scalar fields.
Table service_documents {
  id text [pk]
  kind text [not null, note: 'conversation, map-library, selection']
  data jsonb [not null, note: 'Session messages/capability hash or map/POI/standby document']
  updated_at timestamp [not null, default: `now()`]
  indexes {
    (kind, updated_at)
  }
}

Ref: maps.robot_id > robots.id
Ref: pois.map_id > maps.id [delete: cascade]
Ref: keepout_zones.map_id > maps.id [delete: cascade]
Ref: jobs.robot_id > robots.id
Ref: job_events.job_id > jobs.id [delete: cascade]
Ref: telemetry_samples.robot_id > robots.id
Ref: control_lock.robot_id - robots.id
