# ── Backend (apps/backend) ──────────────────────────────────
PORT=4000
# memory = ไม่ต้องมี PostgreSQL (ข้อมูลในหน่วยความจำ + หุ่นจำลอง)
# pg     = ใช้ PostgreSQL (ต้องเปิด docker compose up d ก่อน)
DB_MODE=memory
DATABASE_URL=postgresql://hermes:hermes@localhost:5432/hermes
SESSION_SECRET=dev-only-secret-change-me
CORS_ORIGIN=http://localhost:3000
HERMES_BASE_URL=http://192.168.1.50:1448
KIOSK_TOKEN=dev-kiosk-token

# ── Admin (apps/admin) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
