# ── Backend (apps/backend) ──────────────────────────────────
PORT=4000
# memory = ไม่ต้องมี PostgreSQL (ข้อมูลในหน่วยความจำ + หุ่นจำลอง)
# pg     = ใช้ PostgreSQL (เช่น docker compose up -d)
DB_MODE=memory
# sim = หุ่นจำลอง, hermes = REST API ของหุ่นจริง (ต้องมีแผนที่ที่ตรงกับ SLAM)
ROBOT_MODE=sim
DATABASE_URL=postgresql://hermes:hermes@localhost:5432/hermes
INITIAL_ADMIN_PASSWORD=change-this-to-a-long-random-password
SESSION_SECRET=dev-only-secret-change-me
CORS_ORIGIN=http://localhost:3000
HERMES_BASE_URL=http://192.168.1.50:1448
# GET-only real robot inspection. Enable movement only after a supervised test is agreed.
HERMES_READ_ONLY=true
HERMES_MAX_LINEAR_MPS=0.1
HERMES_MAX_ANGULAR_RPS=0.3
# Disabled on real hardware unless explicitly enabled outside the narrow lab.
HERMES_AUTO_DOCK=false
KIOSK_TOKEN=dev-kiosk-token

# Phase 2: local llama-server (ข้อความก่อน; STT/TTS ยังไม่เชื่อม)
AI_MODE=off
AI_BASE_URL=http://127.0.0.1:8080
AI_MODEL=qwen3.5-2b
AI_MIN_CONFIDENCE=0.8
# การค้นเว็บในแชตผ่าน SearXNG บน Docker (โปรไฟล์ ai)
SEARXNG_URL=http://127.0.0.1:8888
# เปลี่ยนเป็นค่าสุ่มก่อนเปิดใช้ SearXNG; ใช้เป็น secret ภายใน container
SEARXNG_SECRET=replace-with-a-long-random-value

# ── Admin (apps/admin) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Kiosk (apps/kiosk, server-side proxy) ───────────────────
API_URL=http://localhost:4000
# ใช้ KIOSK_TOKEN ค่าเดียวกับ backend ด้านบน
